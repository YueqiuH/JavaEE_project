# ============================================================
# 智慧校园服务平台 — 环境变量说明
# 复制此文件为 .env 并填入真实值
# 启动方式：IDEA Run Configuration 中设置 EnvFile 或手动配置环境变量
# ============================================================

# ---- 服务端口 ----
SERVER_PORT=8888

# ---- MySQL 数据库 ----
DB_URL=jdbc:mysql://localhost:3306/school_spring?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&allowMultiQueries=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=change-me

# ---- Redis 缓存（Docker 容器 campus-redis，默认无密码）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1

# ---- CORS 跨域（前端 Vite 开发服务器地址）----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- 日志级别（TRACE / DEBUG / INFO / WARN / ERROR）----
LOG_LEVEL_APP=INFO

# ---- 认证与会话（Redis session + RBAC）----
# 会话有效期，支持 ms/s/m/h/d 后缀，如 2h / 30m / 1d
AUTH_SESSION_TTL=2h
# 是否开启滑动过期（每次请求刷新 TTL）
AUTH_SLIDING_EXPIRATION=true
# Redis 中 session key 前缀
AUTH_REDIS_KEY_PREFIX=auth:session:
# 无需认证的公开路径（逗号分隔）
AUTH_PUBLIC_PATHS=/api/v1/auth/login

# ---- AI 自然语言报表（D6，可选）----
# 不配置则 AI 功能不可用，不影响核心业务
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
